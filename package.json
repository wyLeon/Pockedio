{
  "name": "pockedio",
  "version": "0.4.0",
  "private": true,
  "description": "CLI-first personal AI DJ for context-aware listening.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pockedio": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/privacy.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyLeon/Pockedio.git"
  },
  "bugs": {
    "url": "https://github.com/wyLeon/Pockedio/issues"
  },
  "homepage": "https://github.com/wyLeon/Pockedio#readme",
  "keywords": [
    "cli",
    "ai",
    "music",
    "dj",
    "radio",
    "netease",
    "tts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "commander": "^13.1.0",
    "csv-parse": "^5.6.0",
    "inquirer": "^12.5.0",
    "openai": "^4.100.0",
    "undici": "^7.28.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
