# Copy this file to .env for local development if you want shell-loaded keys.
# Do not put real secrets in .env.example.

# Hosted LLM providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional local vLLM compatibility key.
# Pockedio can also save a local placeholder when using a local server.
VLLM_API_KEY=

# Optional NetEase API base URL override.
NETEASE_API_BASE_URL=http://127.0.0.1:3000
